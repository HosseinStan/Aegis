APP_ENV=development
HTTP_LISTEN_ADDRESS=:8080
PUBLIC_BASE_URL=http://localhost:8080

DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/aegis.db

AUTH_MODE=local_jwt
JWT_ISSUER=aegis-api
JWT_AUDIENCE=office-vue-app
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
# Generate independently: openssl rand -base64 32
JWT_SIGNING_KEY=

# Exactly 32 bytes after base64 decoding. Generate independently from JWT key.
CREDENTIAL_MASTER_KEY=
SSH_KNOWN_HOSTS_FILE=./data/known_hosts

SSH_CONNECT_TIMEOUT=5s
SSH_HANDSHAKE_TIMEOUT=10s
DEVICE_COMMAND_TIMEOUT=30s
REQUEST_TIMEOUT=45s
MAX_OUTPUT_BYTES=5242880

CONFIG_CACHE_TTL=15s
FACTS_CACHE_TTL=5m
INTERFACE_CACHE_TTL=30s
MAX_CONCURRENT_DEVICE_CONNECTIONS=10
MAX_CONNECTIONS_PER_DEVICE=1

BACKUP_STORAGE_PATH=./data/backups
BACKUP_ENCRYPTION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
METRICS_ENABLED=true
LOCAL_TEST_CONSOLE_ENABLED=true
OPENAPI_SPEC_PATH=../../packages/shared-contracts/openapi/aegis-api.yaml

# Optional one-time local administrator bootstrap. Remove after first startup.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Planned integrations; not implemented in this milestone.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
