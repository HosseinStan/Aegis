# Docker Compose environment. Generate the two keys independently with
# `openssl rand -base64 32`. Do not commit populated values.
APP_ENV=development
HTTP_LISTEN_ADDRESS=:8080
DATABASE_DSN=./data/aegis.db
BACKUP_STORAGE_PATH=./data/backups
AEGIS_HOST=localhost
AEGIS_HTTP_PORT=8081
AEGIS_HTTPS_PORT=8443
AEGIS_PUBLIC_BASE_URL=https://localhost:8443
JWT_SIGNING_KEY=
CREDENTIAL_MASTER_KEY=
CORS_ALLOWED_ORIGINS=https://localhost
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
